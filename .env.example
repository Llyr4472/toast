# Toast Environment Variables Example

# Domain Configuration for Custom Subdomain Setups
# (Set in Cloudflare Worker `vars` or environment variables)
OAST_DOMAIN="t.yourdomain.com"
DASHBOARD_DOMAIN="toast.yourdomain.com"
BASE_DOMAIN="yourdomain.com"

# DNS Sync Secret (Set on Cloudflare Worker via `npx wrangler secret put DNS_SYNC_SECRET`)
DNS_SECRET="toast_sec_your_custom_secret_here"

# Cloudflare Worker Production URL
WORKER_URL="https://toast.<your-subdomain>.workers.dev"

# Port for UDP 53 Daemon
DNS_PORT=53
