{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "toast",
  "main": "src/index.js",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "toast-db",
      "database_id": "REPLACE_WITH_YOUR_D1_ID"
    }
  ]
}